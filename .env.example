# KKTC TÜFE RESTful API Konfigürasyonu

# Sunucu Ayarları
PORT=3000
HOST=0.0.0.0

# Güvenlik ve Yetkilendirme
# POST /api/v1/sync tetiklemesi için gerekli API Key
API_KEY=kktc_tufe_secret_key_2026

# Hız Sınırlaması (Rate Limiter)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Otomatik Veri Senkronizasyonu Zamanlayıcısı (Cron Formatı)
# Varsayılan: Her gün 09:00 UTC
# Hem resmi TÜFE bültenini hem de GitHub'daki sepet CSV'sini kontrol eder.
CRON_SCHEDULE="0 9 * * *"

# Resmi Veri Kaynağı
RSS_URL=https://istatistik.gov.ct.tr/HABERLER/rss/category/4213/haberler
USER_AGENT="Mozilla/5.0 (compatible; KKTC-TUFE-API/1.0; +https://github.com/)"

# Sepet Madde Fiyatları Kaynağı (elle güncellenen CSV deposu)
GITHUB_ITEMS_CSV_URL=https://raw.githubusercontent.com/RYucel/kktc_tufe/main/GRETL_TUFE.csv
