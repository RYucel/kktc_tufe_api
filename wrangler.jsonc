{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kktc-tufe-api",
  "main": "src/worker.entry.js",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Not: Worker'da "scheduled" handler yoktur; veri build-time'da bundle'a
  // gömülür. Senkronizasyon + yeniden yayınlama işini GitHub Actions
  // (.github/workflows/sync_and_deploy.yml) üstlenir.
  "vars": {
    "ENVIRONMENT": "production"
  },
  // Kullanım sayacı: tek global Durable Object örneği (SQLite destekli).
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_COUNTER",
        "class_name": "UsageCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UsageCounter"]
    }
  ]
}
